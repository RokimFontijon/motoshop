erDiagram
    direction LR
    roles ||--o{ users : "has"
    users ||--o{ job_orders : "mechanic of"
    customers ||--o{ motorcycles : "owns"
    motorcycle_models ||--o{ motorcycles : "is a"
    motorcycles ||--o{ job_orders : "visits"
    job_orders ||--o{ job_order_services : "includes"
    service_types ||--o{ job_order_services : "done in"
    service_types ||--o{ service_intervals : "defines"
    motorcycle_models ||--o{ service_intervals : "defines"
    job_orders ||--o{ job_order_parts : "uses"
    parts ||--o{ job_order_parts : "used in"

    roles {
        bigint id PK
        varchar name UK
    }
    users {
        bigint id PK
        varchar name
        varchar email UK
        varchar password
        bigint role_id FK
    }
    customers {
        bigint id PK
        varchar full_name
        varchar phone
        varchar address
    }
    motorcycle_models {
        bigint id PK
        varchar brand
        varchar name
        smallint engine_cc
    }
    motorcycles {
        bigint id PK
        bigint customer_id FK
        bigint motorcycle_model_id FK
        varchar plate_number UK
        smallint year
        int current_odometer
    }
    service_types {
        bigint id PK
        varchar name UK
    }
    service_intervals {
        bigint id PK
        bigint motorcycle_model_id FK
        bigint service_type_id FK
        int interval_km
        smallint interval_months
    }
    parts {
        bigint id PK
        varchar part_code UK
        varchar name
        decimal unit_price
        int stock_qty
        int reorder_level
    }
    job_orders {
        bigint id PK
        varchar job_number UK
        bigint motorcycle_id FK
        bigint mechanic_id FK
        date service_date
        int odometer_at_service
        varchar status
        decimal labor_cost
    }
    job_order_services {
        bigint job_order_id PK,FK
        bigint service_type_id PK,FK
    }
    job_order_parts {
        bigint id PK
        bigint job_order_id FK
        bigint part_id FK
        int quantity
        decimal unit_price
    }
