APP_NAME="Motorcycle Repair Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------
# PostgreSQL connection (COMP 018: Laravel connection settings).
# These values match database/sql/00_bootstrap.sql, so run that
# script first. The passwords are for classroom use only.
#
#   shop_owner  = owns the tables, used by "php artisan migrate" (default below)
#   shop_app    = least-privilege runtime user. After migrating you may switch to:
#                 DB_USERNAME=shop_app  DB_PASSWORD=app_pass_123
# ---------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=motorshop
DB_USERNAME=shop_owner
DB_PASSWORD=owner_pass_123

# Used only by scripts/backup.sh, scripts/restore.sh and scripts/restore_test.sh (Laravel ignores these two).
BACKUP_DB_USERNAME=shop_backup
BACKUP_DB_PASSWORD=backup_pass_123

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="shop@example.com"
MAIL_FROM_NAME="${APP_NAME}"
